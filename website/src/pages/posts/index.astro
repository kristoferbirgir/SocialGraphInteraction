---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";

const modules = import.meta.glob("./*.md", { eager: true }) as Record<
  string,
  { frontmatter: Record<string, any> }
>;

const posts = Object.entries(modules)
  .map(([path, mod]) => ({
    slug: path.replace("./", "").replace(/\.md$/, ""),
    frontmatter: mod.frontmatter,
  }))
  .sort((a, b) => (a.frontmatter.week ?? 0) - (b.frontmatter.week ?? 0));
---

<BaseLayout title="Posts">
  <h1>Posts</h1>
  {posts.length === 0 && <p class="placeholder">No posts yet.</p>}
  {
    posts.map((post) => (
      <div class="card post-list-item">
        <h3>
          <a href={withBase(`posts/${post.slug}`)}>{post.frontmatter.title}</a>
        </h3>
        <p class="meta">
          {post.frontmatter.week && <span class="tag">Week {post.frontmatter.week}</span>}
          {post.frontmatter.status && <span class="tag">{post.frontmatter.status}</span>}
        </p>
      </div>
    ))
  }
</BaseLayout>
